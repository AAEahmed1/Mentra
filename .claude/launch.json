{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mentra-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mentra-local-prod",
      "runtimeExecutable": "env",

# Runtime database connection (Project Settings → Database → Connection string).
# The direct connection is IPv6-only and unreachable from some networks/CI, so use
# a pooler. On Vercel use the TRANSACTION pooler (port 6543): each serverless
# instance opens its own connections, and the session pooler holds one per client,
# which exhausts under concurrency. Locally, use a Prisma dev server instead:
#   npx prisma dev --name mentra -d && npx prisma dev ls
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migration connection — SESSION pooler (port 5432). Prisma Migrate needs
# session-level advisory locks, which the transaction pooler doesn't support.
# Only needed where the two differ (i.e. in production). Locally, DELETE this
# line: it falls back to DATABASE_URL only when absent, not when empty.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Separate database for the tests, which create and delete real rows. vitest
# refuses to start if this is unset or equal to DATABASE_URL, so a test run can
# never touch real student data. Every test run needs it, including unit tests.
# Create one locally (see docs/development.md):
#   npx prisma dev --name mentra-test -d
#   npx prisma dev ls                      (copy its URL here; ports vary)
#   DATABASE_URL="<that URL>" npx prisma migrate deploy
# Remove DIRECT_URL from .env first: when set, the Prisma CLI uses it instead.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Better Auth. In production this must be the deployed origin (e.g.
# https://mentra.vercel.app) — OAuth callbacks are rejected otherwise.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID → Web application). Authorized redirect URI must be exactly
# <BETTER_AUTH_URL>/api/auth/callback/google. Leave both blank to disable
# Google sign-in entirely — the button is hidden rather than shipped dead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI, for the assistant. Without a key the rest of the app works and the
# assistant answers 503. Ranking is deterministic (see
# src/lib/recommendations.ts), so the assistant only routes to a tool and
# phrases the result. The cost-optimized model (gpt-5.6-luna) was the original
# default, but it could not chain tool calls: asked to attach a note to a piece
# of work it skipped the id lookup, wrote the context into the note body, and
# reported success anyway. gpt-5.6-terra does the lookup and attaches properly,
# so it is the default despite costing roughly ten times as much per turn.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"

# Sentry. The DSN is public — it ships in the browser bundle and only permits
# sending events. Leave it blank to disable error reporting entirely; both
# instrumentation files no-op without it.
NEXT_PUBLIC_SENTRY_DSN=""

# Build-time only, for source-map upload (Settings > Auth Tokens, scoped
# project:releases and org:read). Without it the build still succeeds and
# errors still report — you just get minified stack traces. The org and project
# are set in next.config.ts; the token's own region decides the upload host.
SENTRY_AUTH_TOKEN=""

# Runtime database connection (Project Settings → Database → Connection string).
# The direct connection is IPv6-only and unreachable from some networks/CI, so use
# a pooler. On Vercel use the TRANSACTION pooler (port 6543): each serverless
# instance opens its own connections, and the session pooler holds one per client,
# which exhausts under concurrency. Locally, session pooler (5432) is fine for both.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migration connection — SESSION pooler (port 5432). Prisma Migrate needs
# session-level advisory locks, which the transaction pooler doesn't support.
# Only needed where the two differ (i.e. in production); falls back to
# DATABASE_URL when unset.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Separate database for the integration tests, which create and delete real
# rows. vitest refuses to start if this is unset or equal to DATABASE_URL, so
# a test run can never touch real student data. Start one locally with:
#   npx prisma dev start mentra
#   npx prisma migrate deploy   (with DATABASE_URL pointed at it)
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Better Auth. In production this must be the deployed origin (e.g.
# https://mentra.vercel.app) — OAuth callbacks are rejected otherwise.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID → Web application). Authorized redirect URI must be exactly
# <BETTER_AUTH_URL>/api/auth/callback/google. Leave both blank to disable
# Google sign-in entirely — the button is hidden rather than shipped dead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (used starting ticket 07). The assistant's job is narrow — read intent,
# call a tool, phrase the result — because ranking is deterministic (see
# src/lib/recommendations.ts), so the cost-optimized model is the default.
# Swap to gpt-5.6-terra if tool-call accuracy proves insufficient in practice.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
